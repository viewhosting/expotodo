SELECT p.ID, p.post_title, p.post_type, p.post_status FROM z6eEZRM8_posts p INNER JOIN z6eEZRM8_term_relationships tr ON (p.ID = tr.object_id) WHERE p.post_type = 'product' AND p.post_status = 'publish' AND tr.term_taxonomy_id = 258 -- Categoría Ganchos AND p.ID NOT IN ( SELECT object_id FROM z6eEZRM8_term_relationships WHERE term_taxonomy_id = 7 -- Excluir del catálogo (Ocultos) ) ORDER BY p.post_date DESC;



